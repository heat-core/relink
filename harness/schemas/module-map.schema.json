{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReLink Modular Architecture Map",
  "type": "object",
  "required": ["schema_version", "modules"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "modules": {
      "type": "array",
      "minItems": 19,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "responsibility",
          "source_paths",
          "dependencies",
          "public_interfaces",
          "relevant_tests",
          "security_sensitivity",
          "regression_impact",
          "ownership_boundary"
        ],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "responsibility": { "type": "string", "minLength": 1 },
          "source_paths": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "dependencies": { "type": "array", "items": { "type": "string" } },
          "public_interfaces": { "type": "array", "items": { "type": "string" } },
          "relevant_tests": { "type": "array", "items": { "type": "string" } },
          "security_sensitivity": { "type": "string", "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW"] },
          "regression_impact": { "type": "string" },
          "ownership_boundary": { "type": "string" }
        }
      }
    }
  }
}
